@baseUrl = http://localhost:8081/api

### 1. Test Login 
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "alex.morgan@eztask.dev",
  "password": "password123"
}

@authToken = {{loginAdmin.response.body.token}}

### 2. Test Get Current User Profile (/me) using the Token
GET {{baseUrl}}/auth/me
Authorization: Bearer {{authToken}}

### 3. Test new User Register 
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": Malkros",
  "email": "malkros.test@eztask.dev",
  "password": "password123",
  "role": "Lead Architect",
  "avatar": "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=150&auto=format&fit=crop&q=80"
}

### 4. Test Sign in with Wrong Password
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "alex.morgan@eztask.dev",
  "password": "wrong-pass"
}
